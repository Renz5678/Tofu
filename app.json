{
  "expo": {
    "name": "Tofu",
    "slug": "tofu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon/iconWithBg.png",
    "scheme": "tofu",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/app-icon/iconWithBg.png",
      "resizeMode": "contain",
      "backgroundColor": "#fbf9f4"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tofu.readingtracker"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon/iconWithBg.png",
        "backgroundColor": "#fbf9f4"
      },
      "package": "com.tofu.readingtracker"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
